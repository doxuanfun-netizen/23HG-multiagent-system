#!/bin/sh
# Kiểm tra trước khi push: chạy đúng các bước CI.
# Bật một lần cho bản clone:   git config core.hooksPath .githooks
# Bỏ qua khi thật cần:          git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
PY="${PYTHON:-python3}"
command -v "$PY" >/dev/null 2>&1 || PY=python

echo "[pre-push] 1/2 Bộ test gốc (như CI)..."
"$PY" -m unittest discover -s tests -t . -q

echo "[pre-push] 2/2 Tự kiểm tra solver + CPM (như CI)..."
"$PY" run_state_graph.py --solver-test > /dev/null

echo "[pre-push] OK"
